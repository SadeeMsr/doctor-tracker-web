# Base URL of the Express API. Next.js rewrites /api/* to it, so the browser never calls it directly.
# Local:      http://localhost:4000
# Production: https://<your-api>.onrender.com
API_URL=http://localhost:4000

# Optional: show a one-click "Use the demo account" button on the login page (for reviewers).
# Leave unset in a real deployment.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
